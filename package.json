{
  "name": "mytunes",
  "productName": "MyTunes",
  "version": "1.4.0",
  "description": "MyTunes — локальный музыкальный плеер",
  "main": "main.js",
  "author": "MyTunes",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "screenshots": "electron scripts/screenshots.js",
    "android:sync": "node scripts/prepare-www.js && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "icons": "electron scripts/icons.js"
  },
  "build": {
    "appId": "app.mytunes.player",
    "productName": "MyTunes",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "!node_modules/@capacitor/**",
      "!node_modules/@capgo/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MyTunes",
      "artifactName": "MyTunes-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "MyTunes-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KnpSrb",
        "repo": "mytunes",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "ogg",
          "oga",
          "m4a",
          "aac"
        ],
        "name": "MyTunes Audio",
        "description": "Аудиофайл",
        "role": "Viewer"
      }
    ],
    "afterPack": "scripts/after-pack.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsqr": "^1.4.0",
    "rcedit": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KnpSrb/mytunes.git"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capgo/capacitor-media-session": "^8.1.11",
    "electron-updater": "^6.8.11"
  }
}
