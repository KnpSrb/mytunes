{
  "name": "mytunes",
  "productName": "MyTunes",
  "version": "1.2.0",
  "description": "MyTunes — локальный музыкальный плеер",
  "main": "main.js",
  "author": "MyTunes",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "screenshots": "electron scripts/screenshots.js"
  },
  "build": {
    "appId": "app.mytunes.player",
    "productName": "MyTunes",
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MyTunes",
      "artifactName": "MyTunes-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MyTunes-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KnpSrb",
        "repo": "mytunes",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "flac",
          "wav",
          "ogg",
          "oga",
          "m4a",
          "aac"
        ],
        "name": "MyTunes Audio",
        "description": "Аудиофайл",
        "role": "Viewer"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KnpSrb/mytunes.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
